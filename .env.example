# ───────────── NEXORA environment (copy to .env and change every value) ─────────────
# Never commit .env. These placeholders are for local development only.

# Public entry point
NEXORA_HTTP_PORT=8088
NEXORA_PUBLIC_URL=http://localhost:8088

# MySQL
MYSQL_DATABASE=nexora
MYSQL_USER=nexora
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Auth (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-string-of-at-least-48-characters-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Seed demo data on first start (local development only)
NEXORA_SEED_DEMO=true
NEXORA_DEMO_PASSWORD=ChangeMe-Demo-2026!

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
